# Copie para .env.local e preencha com os dados do SEU projeto Supabase
# (Project Settings > API Keys / Data API).

# URL do projeto: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable key "sb_publishable_..." ou a anon key legada).
# É segura no navegador: o acesso é limitado pelas políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site, usada nos links de confirmação de e-mail.
# Local: http://localhost:3000 | Produção: https://<seu-app>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave secreta (secret key "sb_secret_..." ou a service_role legada).
# Usada SOMENTE pelo script de seed (pnpm seed). Nunca use no front-end
# e não cadastre na Vercel.
SUPABASE_SECRET_KEY=

# Senha da conta de demonstração criada pelo seed (demo@orangeportfolio.dev).
DEMO_PASSWORD=
